{
  "case_id": "themeA_tc1",
  "company": "FinNova Capital",
  "theme": "FINSWARM",
  "problem": "FinNova Capital, a fictional Indian digital lender to registered small businesses, has INR 30 crore for a one-year small-business lending pilot and INR 60 lakh for customer acquisition, of which INR 18 lakh is product setup. It can approve at most 700 loans across three segments - retail shops, service SMEs and small manufacturers - and must choose one primary segment or a justified portfolio mix, together with pricing and an approval policy. Cost of funds is 10% per year and servicing is 1.5% of principal per year.",
  "decision_question": "Which segment mix, pricing, approval policy and launch plan creates the strongest risk-adjusted business outcome?",
  "roster": [
    {
      "id": "research",
      "title": "Business Research Agent",
      "mandate": "Analyse market size, customer demand, competitors, segment opportunity and volume feasibility.",
      "signals": [
        "demand_confidence"
      ]
    },
    {
      "id": "finance",
      "title": "Finance and Treasury Agent",
      "mandate": "Evaluate cost of funds, servicing cost, deployable capital, liquidity and net profitability.",
      "signals": [
        "margin_health",
        "liquidity_health"
      ]
    },
    {
      "id": "credit_risk",
      "title": "Credit Risk Agent",
      "mandate": "Assess expected credit losses, portfolio default, segment concentration and portfolio quality.",
      "signals": [
        "risk_score"
      ]
    },
    {
      "id": "marketing",
      "title": "Marketing and Sales Agent",
      "mandate": "Target customer segments, positioning, acquisition channels and acquisition budget.",
      "signals": [
        "customer_impact",
        "growth_potential"
      ]
    },
    {
      "id": "compliance",
      "title": "Compliance and Customer Protection Agent",
      "mandate": "Fair customer treatment, affordability, conduct risk and regulatory exposure.",
      "signals": [
        "compliance_health"
      ]
    }
  ],
  "ceo": {
    "title": "CEO Agent",
    "objective": "Balance sustainable growth, affordability, expected credit losses, liquidity, operational capacity, fair customer treatment and compliance. Do not approve a strategy solely because it maximizes short-term revenue."
  },
  "guardrails": [
    "This is a synthetic corporate strategy exercise, not personal financial advice.",
    "Do not infer protected characteristics or recommend discriminatory lending. Segment only on business type, loan size and observed default history."
  ],
  "required_decision_fields": [
    "customer_segment",
    "product_terms",
    "approval_policy",
    "budget_allocation",
    "risk_limits",
    "go_to_market",
    "implementation_sequence",
    "measurable_outcomes"
  ],
  "variables": [
    {
      "key": "capital",
      "value": 300000000,
      "unit": "INR",
      "source": "case_pack",
      "visible_to": [
        "finance",
        "credit_risk"
      ],
      "note": ""
    },
    {
      "key": "cost_of_funds",
      "value": 0.1,
      "unit": "fraction/yr",
      "source": "case_pack",
      "visible_to": [
        "finance"
      ],
      "note": ""
    },
    {
      "key": "servicing_rate",
      "value": 0.015,
      "unit": "fraction of principal/yr",
      "source": "case_pack",
      "visible_to": [
        "finance"
      ],
      "note": ""
    },
    {
      "key": "setup_cost",
      "value": 1800000,
      "unit": "INR",
      "source": "case_pack",
      "visible_to": [
        "finance",
        "marketing"
      ],
      "note": "product setup, deducted from the acquisition budget"
    },
    {
      "key": "acq_budget",
      "value": 4200000,
      "unit": "INR",
      "source": "case_pack",
      "visible_to": [
        "marketing",
        "finance"
      ],
      "note": "INR 60 lakh acquisition budget minus INR 18 lakh setup"
    },
    {
      "key": "liquidity_reserve",
      "value": 30000000,
      "unit": "INR",
      "source": "case_pack",
      "visible_to": [
        "finance",
        "credit_risk"
      ],
      "note": "INR 3 crore must remain undeployed"
    },
    {
      "key": "max_loans",
      "value": 700,
      "unit": "loans",
      "source": "case_pack",
      "visible_to": [
        "research",
        "finance"
      ],
      "note": ""
    },
    {
      "key": "retail_loan",
      "value": 400000,
      "unit": "INR",
      "source": "case_pack",
      "visible_to": [
        "research",
        "finance",
        "credit_risk",
        "compliance"
      ],
      "note": "average retail-shop loan"
    },
    {
      "key": "sme_loan",
      "value": 600000,
      "unit": "INR",
      "source": "case_pack",
      "visible_to": [
        "research",
        "finance",
        "credit_risk",
        "compliance"
      ],
      "note": "average service-SME loan"
    },
    {
      "key": "mfg_loan",
      "value": 900000,
      "unit": "INR",
      "source": "case_pack",
      "visible_to": [
        "research",
        "finance",
        "credit_risk",
        "compliance"
      ],
      "note": "average small-manufacturer loan"
    },
    {
      "key": "retail_default",
      "value": 0.05,
      "unit": "fraction",
      "source": "case_pack",
      "visible_to": [
        "credit_risk",
        "compliance",
        "finance"
      ],
      "note": "expected default, retail shops"
    },
    {
      "key": "sme_default",
      "value": 0.035,
      "unit": "fraction",
      "source": "case_pack",
      "visible_to": [
        "credit_risk",
        "compliance",
        "finance"
      ],
      "note": "expected default, service SMEs"
    },
    {
      "key": "mfg_default",
      "value": 0.045,
      "unit": "fraction",
      "source": "case_pack",
      "visible_to": [
        "credit_risk",
        "compliance",
        "finance"
      ],
      "note": "expected default, small manufacturers"
    },
    {
      "key": "retail_demand",
      "value": 1500,
      "unit": "loans",
      "source": "case_pack",
      "visible_to": [
        "research",
        "marketing"
      ],
      "note": "available retail demand"
    },
    {
      "key": "sme_demand",
      "value": 900,
      "unit": "loans",
      "source": "case_pack",
      "visible_to": [
        "research",
        "marketing"
      ],
      "note": "available SME demand"
    },
    {
      "key": "mfg_demand",
      "value": 450,
      "unit": "loans",
      "source": "case_pack",
      "visible_to": [
        "research",
        "marketing"
      ],
      "note": "available manufacturer demand"
    },
    {
      "key": "retail_acq",
      "value": 2000,
      "unit": "INR/customer",
      "source": "case_pack",
      "visible_to": [
        "marketing"
      ],
      "note": ""
    },
    {
      "key": "sme_acq",
      "value": 3500,
      "unit": "INR/customer",
      "source": "case_pack",
      "visible_to": [
        "marketing"
      ],
      "note": ""
    },
    {
      "key": "mfg_acq",
      "value": 5500,
      "unit": "INR/customer",
      "source": "case_pack",
      "visible_to": [
        "marketing"
      ],
      "note": ""
    },
    {
      "key": "default_limit",
      "value": 0.05,
      "unit": "fraction",
      "source": "case_pack",
      "visible_to": [
        "credit_risk",
        "compliance"
      ],
      "note": "expected portfolio default must stay at or below this"
    },
    {
      "key": "rate_limit",
      "value": 0.19,
      "unit": "fraction",
      "source": "case_pack",
      "visible_to": [
        "compliance",
        "finance"
      ],
      "note": "average annual customer interest ceiling"
    },
    {
      "key": "concentration_limit",
      "value": 0.7,
      "unit": "fraction",
      "source": "case_pack",
      "visible_to": [
        "credit_risk"
      ],
      "note": "no segment above this share of deployed capital"
    }
  ],
  "levers": [
    {
      "key": "n_retail",
      "min": 0,
      "max": 1500,
      "step": 1,
      "owner": "marketing"
    },
    {
      "key": "n_sme",
      "min": 0,
      "max": 900,
      "step": 1,
      "owner": "marketing"
    },
    {
      "key": "n_mfg",
      "min": 0,
      "max": 450,
      "step": 1,
      "owner": "marketing"
    },
    {
      "key": "rate",
      "min": 0.12,
      "max": 0.19,
      "step": 0.005,
      "owner": "finance"
    }
  ],
  "metrics": {
    "deployed": "n_retail*retail_loan + n_sme*sme_loan + n_mfg*mfg_loan",
    "credit_loss": "n_retail*retail_loan*retail_default + n_sme*sme_loan*sme_default + n_mfg*mfg_loan*mfg_default",
    "interest_income": "deployed * rate",
    "funding_cost": "deployed * cost_of_funds",
    "servicing_cost": "deployed * servicing_rate",
    "acquisition_spend": "n_retail*retail_acq + n_sme*sme_acq + n_mfg*mfg_acq",
    "net_income": "interest_income - credit_loss - funding_cost - servicing_cost - acquisition_spend - setup_cost",
    "portfolio_default_pct": "credit_loss / max(deployed, 1)",
    "undeployed_capital": "capital - deployed",
    "max_segment_share": "max(n_retail*retail_loan, n_sme*sme_loan, n_mfg*mfg_loan) / max(deployed, 1)",
    "total_loans": "n_retail + n_sme + n_mfg"
  },
  "constraints": [
    {
      "id": "default_cap",
      "expr": "portfolio_default_pct <= default_limit",
      "label": "Expected portfolio default must remain at or below 5%",
      "owner": "credit_risk"
    },
    {
      "id": "rate_cap",
      "expr": "rate <= rate_limit",
      "label": "Average annual customer interest must not exceed 19%",
      "owner": "compliance"
    },
    {
      "id": "concentration",
      "expr": "max_segment_share <= concentration_limit",
      "label": "No segment may receive more than 70% of deployed capital",
      "owner": "credit_risk"
    },
    {
      "id": "liquidity",
      "expr": "undeployed_capital >= liquidity_reserve",
      "label": "At least INR 3 crore must remain undeployed as a liquidity reserve",
      "owner": "finance"
    },
    {
      "id": "loan_cap",
      "expr": "total_loans <= max_loans",
      "label": "Total approved loans cannot exceed 700",
      "owner": "research"
    },
    {
      "id": "acq_cap",
      "expr": "acquisition_spend <= acq_budget",
      "label": "Acquisition spend within the budget remaining after setup cost",
      "owner": "marketing"
    },
    {
      "id": "demand_retail",
      "expr": "n_retail <= retail_demand",
      "label": "Cannot lend to more retail shops than the available demand",
      "owner": "research"
    },
    {
      "id": "demand_sme",
      "expr": "n_sme <= sme_demand",
      "label": "Cannot lend to more service SMEs than the available demand",
      "owner": "research"
    },
    {
      "id": "demand_mfg",
      "expr": "n_mfg <= mfg_demand",
      "label": "Cannot lend to more small manufacturers than the available demand",
      "owner": "research"
    }
  ],
  "direction": {
    "net_income": "max",
    "portfolio_default_pct": "min",
    "deployed": "max"
  },
  "objective": "net_income",
  "score_inputs": {
    "value": "metric:net_income",
    "efficiency": "metric:portfolio_default_pct",
    "feasibility": "signal:liquidity_health",
    "customer": "signal:customer_impact",
    "risk": "signal:risk_score"
  },
  "weights": {
    "value": 0.3,
    "efficiency": 0.25,
    "feasibility": 0.2,
    "customer": 0.15,
    "risk": 0.1
  },
  "seed_strategies": [
    {
      "id": "S_retail",
      "name": "Retail-led volume play",
      "levers": {
        "n_retail": 700,
        "n_sme": 0,
        "n_mfg": 0,
        "rate": 0.19
      }
    },
    {
      "id": "S_greedy",
      "name": "Greedy high-margin (450 mfg + 250 SME)",
      "levers": {
        "n_retail": 0,
        "n_sme": 250,
        "n_mfg": 450,
        "rate": 0.19
      }
    },
    {
      "id": "S_balanced",
      "name": "Diversified three-segment book",
      "levers": {
        "n_retail": 150,
        "n_sme": 200,
        "n_mfg": 100,
        "rate": 0.19
      }
    }
  ]
}
